# Full credential instructions + team checklist: see README.md (Table of contents → Team workflow & each Plugin section).
#
# --- Facebook Page (Graph API) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Optional override (default v19.0)
# FB_GRAPH_VERSION=v19.0
# visual (default) = short caption + branded PNG via Photos API; text = classic feed post
FACEBOOK_POST_MODE=visual
# Internship CTA used on creatives (default https://airepro.in/view/internships)
# AIREPRO_INTERNSHIPS_URL=https://airepro.in/view/internships
# After live Page publish: auto first-comment CTA (unset = on; false/0/no/off = off)
# FB_FIRST_COMMENT_ENABLED=true
# Override first-comment body ({{url}} → AIREPRO_INTERNSHIPS_URL). Else config/facebook_first_comment.json
# FB_FIRST_COMMENT_TEMPLATE=Interested in internships? Apply: {{url}}
# Page comment → Messenger Private Reply when auto-reply is armed (unset = on)
# FB_PRIVATE_REPLY_ENABLED=true
# Optional hub verify token for GET /api/webhooks/facebook (falls back to WHATSAPP_VERIFY_TOKEN)
# FB_VERIFY_TOKEN=

# --- Twitter / X (API v2) — use ONE auth method ---
# OAuth 2.0 user access token with tweet.write:
TWITTER_OAUTH2_ACCESS_TOKEN=
# OR OAuth 1.0a user context (all four required if not using OAuth2):
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Tweet max length (default 280; X premium allows more)
TWITTER_MAX_CHARS=280

# --- LinkedIn (REST Posts API) ---
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:xxxx or urn:li:organization:xxxx
LINKEDIN_AUTHOR_URN=
# Monthly API version header (default 202405)
# LINKEDIN_VERSION=202405

# --- YouTube (Data API: updates existing video title + description) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_VIDEO_ID=

# --- WhatsApp Business Cloud API (Meta Graph) ---
WHATSAPP_ACCESS_TOKEN=
# Phone number ID from Meta Developer → WhatsApp → API setup
WHATSAPP_PHONE_NUMBER_ID=
# Recipient(s): E.164 digits only, comma-separated (e.g. 15551234567,447700900123)
WHATSAPP_TO=
# Optional Graph version (default v21.0)
# WHATSAPP_GRAPH_VERSION=v21.0
# Meta webhook verify token (hub.verify_token) for GET /api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — enables X-Hub-Signature-256 verification on webhook POSTs.
# Unset = verification skipped with a logged warning (local dev only).
WHATSAPP_APP_SECRET=
# Regex auto-reply: when false (default), webhooks only match/log — never send
AUTO_REPLY_ENABLED=false
# Per-platform auto-reply kill switches (unset = enabled; false/0/no/off = disabled)
# AUTO_REPLY_WHATSAPP_ENABLED=true
# AUTO_REPLY_FACEBOOK_ENABLED=true
# Override auto-reply data file locations (used by tests; normally leave unset)
# AUTO_REPLY_RULES_PATH= / AUTO_REPLY_SETTINGS_PATH= / AUTO_REPLY_LOG_PATH= ...

# --- Brand (social copy) ---
# Loads config/brand/{name}.md into generation prompts (default: airepro)
# BRAND_PROFILE=airepro

# --- Ollama ---
# Prefer loopback if Docker/remote host is flaky: http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434
MODEL=gemma:7b-instruct
# Local free Moonshot/Kimi (community GGUF, ~8.8GB): MODEL=richardyoung/kimi-vl-a3b-thinking:iq4_xs
# Cloud via Docker Ollama (needs ollama signin / subscription): MODEL=kimi-k2.6:cloud
# Official library Kimi K2.x tags are cloud-only; full local K2 (~1T) needs workstation RAM (e.g. batiai/kimi-k2.6:iq3 ≥384GB)

# Comma-separated platforms to publish (when not using --only=)
PLATFORMS=facebook,twitter,linkedin,youtube,whatsapp

# Per-platform hard off-switch (applied after PLATFORMS / --only=).
# Unset = enabled. Set to false / 0 / no / off to disable (case-insensitive).
FACEBOOK_ENABLED=true
TWITTER_ENABLED=true
LINKEDIN_ENABLED=true
YOUTUBE_ENABLED=true
WHATSAPP_ENABLED=true

# --- Ops / resilience (optional) ---
# Generate copy but do not call any publish APIs (also: --dry-run CLI flag)
# DRY_RUN=1
# Pin the operator console to dry-run: hides the live toggle and rejects dryRun:false
# UI_FORCE_DRY_RUN=true
# Arm the local schedule queue so due items may publish live (default: always dry-run)
# QUEUE_ARMED=true
# Outbound HTTP timeout for platform/Google calls (ms, default 30000)
# HTTP_TIMEOUT_MS=30000
# Ollama /api/generate timeout (ms, default 120000)
# OLLAMA_TIMEOUT_MS=120000
# Extra retries after first attempt for transient 429/5xx/network (default 2)
# HTTP_RETRIES=2
# Operator API rate limit for mutating routes (requests/min, default 600)
# API_RATE_LIMIT_PER_MIN=600

