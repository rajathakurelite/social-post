{
  "name": "ai-social-agent",
  "version": "1.0.0",
  "description": "AI social automation: Ollama (Gemma) copy + Facebook, X, LinkedIn, YouTube (metadata).",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node scripts/run.js",
    "dev:api": "node server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "vite build --config web/vite.config.js"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "keywords": [
    "ollama",
    "facebook",
    "social",
    "automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "vite": "^8.1.5"
  }
}
