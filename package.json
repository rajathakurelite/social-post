{
  "name": "ai-social-agent",
  "version": "1.0.0",
  "description": "AI social automation: Ollama (Gemma) copy + Facebook, X, LinkedIn, YouTube (metadata).",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node scripts/run.js",
    "dev:api": "node server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "vite build --config web/vite.config.js",
    "smoke:ui": "node scripts/smoke-ui-dryrun.js",
    "smoke:auto-reply": "node scripts/smoke-auto-reply.js",
    "smoke:simulate": "node scripts/simulate-inbox.js",
    "queue:run": "node scripts/queue-runner.js",
    "smoke:matrix": "node scripts/smoke-matrix.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secret-scan": "node scripts/secret-scan.js",
    "doctor": "node scripts/doctor.js",
    "healthcheck": "node scripts/healthcheck.js",
    "seed": "node scripts/seed.js",
    "prune-output": "node scripts/prune-output.js",
    "bundle-size": "node scripts/bundle-size.js",
    "install-hooks": "node scripts/install-hooks.js",
    "generate-env-docs": "node scripts/generate-env-docs.js",
    "check:perf": "node scripts/check-perf-budget.js",
    "check:dead-exports": "node scripts/check-dead-exports.js --plant-test",
    "check:js": "tsc --noEmit -p jsconfig.json",
    "smoke:playwright": "node scripts/playwright-ui-smoke.js",
    "smoke:screenshots": "node scripts/screenshot-regression.js",
    "smoke:mock-ollama": "node scripts/smoke-mock-ollama.js",
    "verify:all": "npm run lint && npm test && npm run format:check && npm run smoke:auto-reply && npm run smoke:ui && npm run build:web && npm run bundle-size && npm run check:perf && npm run check:dead-exports"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "keywords": [
    "ollama",
    "facebook",
    "social",
    "automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
